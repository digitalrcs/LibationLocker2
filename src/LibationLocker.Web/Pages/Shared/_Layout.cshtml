@inject Microsoft.AspNetCore.Http.IHttpContextAccessor _http
@{
    var _userEmail = _http.HttpContext?.Items["ll:email"] as string;
    var _userRole  = _http.HttpContext?.Items["ll:role"]  as string;
    var _isAdmin   = _userRole == "admin";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Libation Locker</title>
    <script>
        (() => {
            const theme = localStorage.getItem("ll-theme") || "cellar-light";
            document.documentElement.setAttribute("data-theme", theme);
            const density = localStorage.getItem("ll-density") || "normal";
            document.documentElement.setAttribute("data-density", density);
        })();
    </script>
    <link rel="stylesheet" href="~/css/themes.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="~/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="~/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="~/apple-touch-icon.png" />
    <link rel="manifest" href="~/site.webmanifest" />
</head>
<body>
    <!-- Floating background decoration -->
    <div class="bg-floaters" aria-hidden="true">
        <!-- Wine bottles -->
        <svg class="bg-floater" style="height:72px" viewBox="0 0 22 58">
            <path d="M9 0h4v4c3 1.5 4 5.5 4 10v3c2 3 3 6 3 10v21a6 5 0 0 1-12 0V27c0-4 1-7 3-10v-3c0-4.5 1-8.5 4-10z"/>
        </svg>
        <svg class="bg-floater" style="height:84px" viewBox="0 0 22 58">
            <path d="M9 0h4v4c3 1.5 4 5.5 4 10v3c2 3 3 6 3 10v21a6 5 0 0 1-12 0V27c0-4 1-7 3-10v-3c0-4.5 1-8.5 4-10z"/>
        </svg>
        <svg class="bg-floater" style="height:60px" viewBox="0 0 22 58">
            <path d="M9 0h4v4c3 1.5 4 5.5 4 10v3c2 3 3 6 3 10v21a6 5 0 0 1-12 0V27c0-4 1-7 3-10v-3c0-4.5 1-8.5 4-10z"/>
        </svg>
        <svg class="bg-floater" style="height:78px" viewBox="0 0 22 58">
            <path d="M9 0h4v4c3 1.5 4 5.5 4 10v3c2 3 3 6 3 10v21a6 5 0 0 1-12 0V27c0-4 1-7 3-10v-3c0-4.5 1-8.5 4-10z"/>
        </svg>
        <svg class="bg-floater" style="height:64px" viewBox="0 0 22 58">
            <path d="M9 0h4v4c3 1.5 4 5.5 4 10v3c2 3 3 6 3 10v21a6 5 0 0 1-12 0V27c0-4 1-7 3-10v-3c0-4.5 1-8.5 4-10z"/>
        </svg>
        <!-- Moonshine jugs -->
        <svg class="bg-floater" style="height:70px" viewBox="0 0 52 56">
            <!-- cork stopper -->
            <ellipse cx="20" cy="4" rx="7" ry="4"/>
            <!-- short neck flowing into fat round body -->
            <path d="M13 7h14v11c8 2 11 8 11 17c0 12-8 19-18 19s-18-7-18-19c0-9 3-15 11-17z"/>
            <!-- loop handle on upper shoulder -->
            <path d="M35 24c8-2 12 5 12 11s-4 12-12 11" fill="none" stroke="currentColor" stroke-width="4.5" stroke-linecap="round"/>
        </svg>
        <svg class="bg-floater" style="height:65px" viewBox="0 0 52 56">
            <!-- cork stopper -->
            <ellipse cx="20" cy="4" rx="7" ry="4"/>
            <!-- short neck flowing into fat round body -->
            <path d="M13 7h14v11c8 2 11 8 11 17c0 12-8 19-18 19s-18-7-18-19c0-9 3-15 11-17z"/>
            <!-- loop handle on upper shoulder -->
            <path d="M35 24c8-2 12 5 12 11s-4 12-12 11" fill="none" stroke="currentColor" stroke-width="4.5" stroke-linecap="round"/>
        </svg>
        <svg class="bg-floater" style="height:88px" viewBox="0 0 52 56">
            <!-- cork stopper -->
            <ellipse cx="20" cy="4" rx="7" ry="4"/>
            <!-- short neck flowing into fat round body -->
            <path d="M13 7h14v11c8 2 11 8 11 17c0 12-8 19-18 19s-18-7-18-19c0-9 3-15 11-17z"/>
            <!-- loop handle on upper shoulder -->
            <path d="M35 24c8-2 12 5 12 11s-4 12-12 11" fill="none" stroke="currentColor" stroke-width="4.5" stroke-linecap="round"/>
        </svg>
        <svg class="bg-floater" style="height:72px" viewBox="0 0 52 56">
            <!-- cork stopper -->
            <ellipse cx="20" cy="4" rx="7" ry="4"/>
            <!-- short neck flowing into fat round body -->
            <path d="M13 7h14v11c8 2 11 8 11 17c0 12-8 19-18 19s-18-7-18-19c0-9 3-15 11-17z"/>
            <!-- loop handle on upper shoulder -->
            <path d="M35 24c8-2 12 5 12 11s-4 12-12 11" fill="none" stroke="currentColor" stroke-width="4.5" stroke-linecap="round"/>
        </svg>
        <svg class="bg-floater" style="height:60px" viewBox="0 0 52 56">
            <!-- cork stopper -->
            <ellipse cx="20" cy="4" rx="7" ry="4"/>
            <!-- short neck flowing into fat round body -->
            <path d="M13 7h14v11c8 2 11 8 11 17c0 12-8 19-18 19s-18-7-18-19c0-9 3-15 11-17z"/>
            <!-- loop handle on upper shoulder -->
            <path d="M35 24c8-2 12 5 12 11s-4 12-12 11" fill="none" stroke="currentColor" stroke-width="4.5" stroke-linecap="round"/>
        </svg>
        <!-- Martini glasses: inverted V bowl, thin stem, flat base -->
        <svg class="bg-floater" style="height:65px" viewBox="0 0 52 60">
            <path d="M1 2h50L28 35v15c6 1 12 3 12 7H12c0-4 6-6 12-7V35L1 2z"/>
        </svg>
        <svg class="bg-floater" style="height:72px" viewBox="0 0 52 60">
            <path d="M1 2h50L28 35v15c6 1 12 3 12 7H12c0-4 6-6 12-7V35L1 2z"/>
        </svg>
        <svg class="bg-floater" style="height:58px" viewBox="0 0 52 60">
            <path d="M1 2h50L28 35v15c6 1 12 3 12 7H12c0-4 6-6 12-7V35L1 2z"/>
        </svg>
        <!-- Cocktail shakers: narrow cap, wide shoulders, cylindrical body -->
        <svg class="bg-floater" style="height:80px" viewBox="0 0 32 62">
            <path d="M8 0h16C26 0 26 2 26 4v8c4 2 6 6 6 10v28c0 6-6 10-14 10S4 56 4 50V22c0-4 2-8 6-10V4C10 2 10 0 8 0z"/>
        </svg>
        <svg class="bg-floater" style="height:65px" viewBox="0 0 32 62">
            <path d="M8 0h16C26 0 26 2 26 4v8c4 2 6 6 6 10v28c0 6-6 10-14 10S4 56 4 50V22c0-4 2-8 6-10V4C10 2 10 0 8 0z"/>
        </svg>
        <svg class="bg-floater" style="height:70px" viewBox="0 0 32 62">
            <path d="M8 0h16C26 0 26 2 26 4v8c4 2 6 6 6 10v28c0 6-6 10-14 10S4 56 4 50V22c0-4 2-8 6-10V4C10 2 10 0 8 0z"/>
        </svg>
        <!-- Corkscrew: oval handle, straight shaft, S-curve worm -->
        <svg class="bg-floater" style="height:72px" viewBox="0 0 36 70">
            <ellipse cx="18" cy="7" rx="14" ry="7"/>
            <rect x="16" y="13" width="4" height="24"/>
            <path d="M18 37C8 42 8 52 18 52C28 52 28 62 18 66" fill="none" stroke="currentColor" stroke-width="5" stroke-linecap="round"/>
        </svg>
    </div>
    <header class="topbar">
        <div class="brand">
            <img class="digitalrcs-mark" src="~/branding/digitalrcs-logo.png" alt="DigitalRCS" />
            <div class="brand-copy">
                <strong>Libation Locker</strong>
                <span>Server Edition &bull; Personal bar inventory</span>
            </div>
        </div>
        <div class="header-right">
            <div class="toolbar-row">
                <nav class="app-tabs" aria-label="Primary navigation">
                    <a href="#inventory" data-view-link="inventory" class="is-active" title="Inventory — browse and search your bar">
                        <svg viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 22h8M12 22v-7M5 3l2 9a5 5 0 0 0 10 0l2-9H5z"/></svg>
                        <span class="tab-label">Inventory</span>
                    </a>
                    <a href="#recipes" data-view-link="recipes" title="Recipes — browse and manage drink recipes">
                        <svg viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/><line x1="12" y1="7" x2="16" y2="7"/><line x1="10" y1="11" x2="16" y2="11"/><line x1="12" y1="15" x2="16" y2="15"/></svg>
                        <span class="tab-label">Recipes</span>
                    </a>
                    <a href="#stats" data-view-link="stats" title="Statistics — charts and analytics for your bar">
                        <svg viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/><polyline points="2 20 22 20"/></svg>
                        <span class="tab-label">Stats</span>
                    </a>
                    <a href="#import-export" data-view-link="import-export" title="Import / Export data">
                        <svg viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="17 1 21 5 17 9"/><path d="M3 11V9a4 4 0 0 1 4-4h14"/><polyline points="7 23 3 19 7 15"/><path d="M21 13v2a4 4 0 0 1-4 4H3"/></svg>
                        <span class="tab-label">Import/Export</span>
                    </a>
                    @if (_isAdmin)
                    {
                        <a href="#config" data-view-link="config" title="Admin — configure dropdowns and AI">
                            <svg viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
                            <span class="tab-label">Admin</span>
                        </a>
                    }
                </nav>
                <span class="status-pill" id="ai-availability-status">AI: checking...</span>
                <div class="toolbar-sep" aria-hidden="true"></div>
                @if (!string.IsNullOrWhiteSpace(_userEmail))
                {
                    <div class="user-profile">
                        <span class="current-user" title="Signed in as @_userEmail">@_userEmail</span>
                        @if (_isAdmin)
                        {
                            <span class="role-badge admin-badge">Admin</span>
                        }
                        <a class="button secondary toolbar-logout" href="/logout" title="Sign out of Libation Locker">Logout</a>
                    </div>
                }
            </div>
            <div class="header-bottom">
                <div class="accordion display-accordion">
                    <button class="accordion-header" data-settings-toggle aria-expanded="false" aria-controls="display-settings" title="Change theme and UI size">
                        <span>Display</span>
                        <svg class="accordion-chevron" viewBox="0 0 24 24" width="12" height="12" stroke="currentColor" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
                    </button>
                    <div class="accordion-body" id="display-settings" hidden>
                        <label class="theme-picker">
                            <span class="picker-label">Theme</span>
                            <select data-theme-select aria-label="Choose colour theme" title="Choose colour theme">
                                <optgroup label="Cellar">
                                    <option value="cellar-light">Cellar Light</option>
                                    <option value="cellar-dark">Cellar Dark</option>
                                </optgroup>
                                <optgroup label="Botanical">
                                    <option value="botanical-light">Botanical Light</option>
                                    <option value="botanical-dark">Botanical Dark</option>
                                </optgroup>
                                <optgroup label="Midnight">
                                    <option value="midnight-light">Midnight Light</option>
                                    <option value="midnight-dark">Midnight Dark</option>
                                </optgroup>
                                <optgroup label="Ocean">
                                    <option value="ocean-light">Ocean Light</option>
                                    <option value="ocean-dark">Ocean Dark</option>
                                </optgroup>
                                <optgroup label="Sapphire">
                                    <option value="sapphire-light">Sapphire Light</option>
                                    <option value="sapphire-dark">Sapphire Dark</option>
                                </optgroup>
                                <optgroup label="Steel">
                                    <option value="steel-light">Steel Light</option>
                                    <option value="steel-dark">Steel Dark</option>
                                </optgroup>
                                <optgroup label="Ember">
                                    <option value="ember-light">Ember Light</option>
                                    <option value="ember-dark">Ember Dark</option>
                                </optgroup>
                                <optgroup label="Copper">
                                    <option value="copper-light">Copper Light</option>
                                    <option value="copper-dark">Copper Dark</option>
                                </optgroup>
                                <optgroup label="Terminal">
                                    <option value="terminal-light">Terminal Light</option>
                                    <option value="terminal-dark">Terminal Dark</option>
                                </optgroup>
                            </select>
                        </label>
                        <label class="density-picker">
                            <span class="picker-label">Size</span>
                            <select data-density-select aria-label="Choose UI size" title="Choose UI density">
                                <option value="xlarge">X-Large</option>
                                <option value="large">Large</option>
                                <option value="normal">Normal</option>
                                <option value="compact">Compact</option>
                                <option value="dense">Dense</option>
                            </select>
                        </label>
                        <div class="display-status-pills">
                            <span class="status-pill" id="storage-status">Storage: loading...</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </header>
    <div class="shell">
        <main role="main">
            @RenderBody()
        </main>
    </div>
    <script src="~/js/theme.js" asp-append-version="true"></script>
    <script src="~/js/floaters.js" asp-append-version="true"></script>
    <script src="https://cdn.plot.ly/plotly-2.35.2.min.js" crossorigin="anonymous"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
